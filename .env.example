# Supabase Postgres (Faz 1'de geçildi — Project Settings > Connect > ORM > Prisma)
# DATABASE_URL: pooled bağlantı (pgbouncer, port 6543) — uygulama çalışma zamanında
# (src/prisma/prisma.service.ts) bunu kullanır.
DATABASE_URL="postgresql://postgres.<proje-ref>:<db-sifresi>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: direkt bağlantı (port 5432) — sadece `prisma migrate`/`prisma studio`
# gibi CLI işlemleri için (bkz. prisma.config.ts). pgbouncer pooler migration'ları
# desteklemiyor.
DIRECT_URL="postgresql://postgres.<proje-ref>:<db-sifresi>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# JWT ile admin auth için secret (rastgele, uzun bir değer kullanın)
JWT_SECRET=change-me-to-a-long-random-secret

# NOT: Lokal geliştirme için docker-compose.yml'deki postgres/redis servisleri
# hâlâ duruyor, isterseniz DATABASE_URL/DIRECT_URL'i geçici olarak
# postgresql://comparaai:comparaai_dev_pw@localhost:5432/comparaai yapıp
# offline çalışabilirsiniz.
