# Local Postgres (docker-compose.yml'deki postgres servisiyle eşleşir)
DATABASE_URL=postgresql://comparaai:comparaai_dev_pw@localhost:5432/comparaai

# JWT ile admin auth için secret (rastgele, uzun bir değer kullanın)
JWT_SECRET=change-me-to-a-long-random-secret

# NOT: Faz 1/8'de Supabase'e geçildiğinde DATABASE_URL, Supabase'in verdiği
# Postgres connection string'i ile değiştirilecek (docker-compose lokal geliştirme
# için kalabilir, production Supabase'e işaret eder).
