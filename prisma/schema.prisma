// ComparaAI - Prisma Şema Taslağı (V0.5)
// Esnek şema yaklaşımı: her kategori için ayrı tablo yerine
// ortak Product tablosu + kategoriye özel alanlar için JSONB (specs)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique // "Telefon", "Laptop", "PC Parçaları", "Ekipman"
  slug      String    @unique // "telefon", "laptop" - URL'lerde kullanılacak
  parent    Category? @relation("SubCategories", fields: [parentId], references: [id])
  parentId  String?
  children  Category[] @relation("SubCategories")
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String     @id @default(cuid())
  name        String
  brand       String
  category    Category   @relation(fields: [categoryId], references: [id])
  categoryId  String

  // Eski fiyat alanları şimdilik veritabanında tutuluyor.
  // Kullanıcı arayüzünde gösterilmeyecek ve segment hesabında kullanılmayacak.
  price       Decimal    @default(0)
  priceMax    Decimal?   @default(0)

  imageUrl    String?
  description String?    @db.Text

  // Yeni gerçek ürün segmenti
  // ekonomik | orta | ust
  segment     String     @default("orta")

  // Kategoriye özel özellikler
  specs       Json

  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  priceHistory PriceHistory[]

  @@index([categoryId])
  @@index([brand])
  @@index([segment])
}

// V2'de aktif kullanılacak ama şemayı şimdiden kuruyoruz
model PriceHistory {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  price     Decimal
  recordedAt DateTime @default(now())

  @@index([productId, recordedAt])
}

// Admin panel için basit kullanıcı modeli (sadece 2 kurucu)
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  twoFactorSecret String? // 2FA için
  createdAt    DateTime @default(now())
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String?
  content     String
  imageUrl    String?
  author      String?
  status      String   @default("draft")
  isPublished Boolean  @default(false)
  aiImportance   String?
  aiWhyItMatters String?
  aiWhoItAffects String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}